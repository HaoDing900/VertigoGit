# Auto detect text files and perform LF normalization
* text=auto
Content/Static/** filter=lfs diff=lfs -merge -text

#Added for LFS
# UE file types
*.uasset filter=lfs diff=lfs -merge -text
*.umap filter=lfs diff=lfs -merge -text
# Raw Content types
*.fbx filter=lfs diff=lfs -merge -text
*.3ds filter=lfs diff=lfs -merge -text
*.psd filter=lfs diff=lfs -merge -text
*.png filter=lfs diff=lfs -merge -text
*.mp3 filter=lfs diff=lfs -merge -text
*.wav filter=lfs diff=lfs -merge -text
*.xcf filter=lfs diff=lfs -merge -text
*.jpg filter=lfs diff=lfs -merge -text
*.zip filter=lfs diff=lfs -merge -text
