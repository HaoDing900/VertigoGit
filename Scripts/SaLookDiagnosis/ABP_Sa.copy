         Node=(BoundBone=(BoneName="Hair_Base"),PhysicsBodyDefinitions=((BoundBone=(BoneName="Hair_Base"))))
         ShowPinForProperties(0)=(PropertyName="ComponentPose",PropertyFriendlyName="Component Pose",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:ComponentPose", "Input link"),CategoryName="Links",bShowPin=True)
         ShowPinForProperties(1)=(PropertyName="LODThreshold",PropertyFriendlyName="LOD Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:LODThreshold", "* Max LOD that this node is allowed to run\n* For example if you have LODThreshold to be 2, it will run until LOD 2 (based on 0 index)\n* when the component LOD becomes 3, it will stop update/evaluate\n* currently transition would be issue and that has to be re-visited"),CategoryName="Performance")
         ShowPinForProperties(2)=(PropertyName="AlphaInputType",PropertyFriendlyName="Alpha Input Type",CategoryName="Alpha")
         ShowPinForProperties(3)=(PropertyName="bAlphaBoolEnabled",PropertyFriendlyName="bEnabled",CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="Alpha",PropertyFriendlyName="Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_SkeletalControlBase:Alpha", "Current strength of the skeletal control"),CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="AlphaScaleBias",PropertyFriendlyName="Alpha Scale Bias",CategoryName="Alpha")
         ShowPinForProperties(6)=(PropertyName="AlphaBoolBlend",PropertyFriendlyName="Blend Settings",CategoryName="Alpha")
         ShowPinForProperties(7)=(PropertyName="AlphaCurveName",PropertyFriendlyName="Alpha Curve Name",CategoryName="Alpha",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="AlphaScaleBiasClamp",PropertyFriendlyName="Alpha Scale Bias Clamp",CategoryName="Alpha")
         ShowPinForProperties(9)=(PropertyName="LinearDampingOverride",PropertyFriendlyName="Linear Damping Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:LinearDampingOverride", "Overridden linear damping value. The default is 0.7. Values below 0.7 won\'t have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(10)=(PropertyName="AngularDampingOverride",PropertyFriendlyName="Angular Damping Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:AngularDampingOverride", "Overridden angular damping value. The default is 0.7. Values below 0.7 won\'t have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(11)=(PropertyName="RelativeSpaceBone",PropertyFriendlyName="Relative Space Bone",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:RelativeSpaceBone", "When in BoneRelative sim space, the simulation will use this bone as the origin"),CategoryName="Setup")
         ShowPinForProperties(12)=(PropertyName="BoundBone",PropertyFriendlyName="Bound Bone",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:BoundBone", "The bone to attach the physics body to, if bChain is true this is the top of the chain"),CategoryName="Setup")
         ShowPinForProperties(13)=(PropertyName="ChainEnd",PropertyFriendlyName="Chain End",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ChainEnd", "If bChain is true this is the bottom of the chain, otherwise ignored"),CategoryName="Setup")
         ShowPinForProperties(14)=(PropertyName="PhysicsBodyDefinitions",PropertyFriendlyName="Body Definitions",CategoryName="PhysicsParameters")
         ShowPinForProperties(15)=(PropertyName="GravityScale",PropertyFriendlyName="Gravity Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:GravityScale", "Scale for gravity, higher values increase forces due to gravity"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bHasOverridePin=True)
         ShowPinForProperties(16)=(PropertyName="GravityOverride",PropertyFriendlyName="Gravity Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:GravityOverride", "Gravity Override Value"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bHasOverridePin=True)
         ShowPinForProperties(17)=(PropertyName="LinearSpringConstant",PropertyFriendlyName="Linear Spring Constant",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:LinearSpringConstant", "Spring constant to use when calculating linear springs, higher values mean a stronger spring.\nYou need to enable the Linear Spring checkbox for this to have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True)
         ShowPinForProperties(18)=(PropertyName="AngularSpringConstant",PropertyFriendlyName="Angular Spring Constant",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:AngularSpringConstant", "Spring constant to use when calculating angular springs, higher values mean a stronger spring.\nYou need to enable the Angular Spring checkbox for this to have an effect.\nNote: Make sure to also set the Angular Target Axis and Angular Target in the Constraint Setup for this to have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True)
         ShowPinForProperties(19)=(PropertyName="WindScale",PropertyFriendlyName="Wind Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:WindScale", "Scale to apply to calculated wind velocities in the solver"),CategoryName="Wind")
         ShowPinForProperties(20)=(PropertyName="ComponentLinearAccScale",PropertyFriendlyName="Component Linear Acc Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ComponentLinearAccScale", "When using non-world-space sim, this controls how much of the components world-space acceleration is passed on to the local-space simulation."),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(21)=(PropertyName="ComponentLinearVelScale",PropertyFriendlyName="Component Linear Vel Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ComponentLinearVelScale", "When using non-world-space sim, this applies a \'drag\' to the bodies in the local space simulation, based on the components world-space velocity."),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(22)=(PropertyName="ComponentAppliedLinearAccClamp",PropertyFriendlyName="Component Applied Linear Acc Clamp",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ComponentAppliedLinearAccClamp", "When using non-world-space sim, this is an overall clamp on acceleration derived from ComponentLinearAccScale and ComponentLinearVelScale, to ensure it is not too large."),CategoryName="Settings")
         ShowPinForProperties(23)=(PropertyName="AngularBiasOverride",PropertyFriendlyName="Angular Bias Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:AngularBiasOverride", "Overridden angular bias value\nAngular bias is essentially a twist reduction for chain forces and defaults to a value to keep chains stability\nin check. When using single-body systems sometimes angular forces will look like they are \"catching-up\" with\nthe mesh, if that\'s the case override this and push it towards 1.0f until it settles correctly"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(24)=(PropertyName="NumSolverIterationsPreUpdate",PropertyFriendlyName="Num Solver Iterations Pre Update",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:NumSolverIterationsPreUpdate", "Number of update passes on the linear and angular limits before we solve the position of the bodies recommended to be four times the value of NumSolverIterationsPostUpdate"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(25)=(PropertyName="NumSolverIterationsPostUpdate",PropertyFriendlyName="Num Solver Iterations Post Update",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:NumSolverIterationsPostUpdate", "Number of update passes on the linear and angular limits after we solve the position of the bodies, recommended to be around a quarter of NumSolverIterationsPreUpdate"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(26)=(PropertyName="SphericalLimits",PropertyFriendlyName="Spherical Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:SphericalLimits", "List of available spherical limits for this node"),CategoryName="SphericalLimit")
         ShowPinForProperties(27)=(PropertyName="ExternalForce",PropertyFriendlyName="External Force",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ExternalForce", "An external force to apply to all bodies in the simulation when ticked, specified in world space"),CategoryName="Forces",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(28)=(PropertyName="PlanarLimits",PropertyFriendlyName="Planar Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:PlanarLimits", "List of available planar limits for this node"),CategoryName="PlanarLimit")
         ShowPinForProperties(29)=(PropertyName="SimulationSpace",PropertyFriendlyName="Simulation Space",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:SimulationSpace", "The space used to run the simulation"),CategoryName="Setup",bCanToggleVisibility=True)
         ShowPinForProperties(30)=(PropertyName="bUseSphericalLimits",PropertyFriendlyName="Use Spherical Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bUseSphericalLimits", "Whether to evaluate spherical limits"),CategoryName="SphericalLimit")
         ShowPinForProperties(31)=(PropertyName="bUsePlanarLimit",PropertyFriendlyName="Use Planar Limit",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bUsePlanarLimit", "Whether to evaluate planar limits"),CategoryName="PlanarLimit")
         ShowPinForProperties(32)=(PropertyName="bDoUpdate",PropertyFriendlyName="Do Update",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bDoUpdate", "If true we will perform physics update, otherwise skip - allows visualization of the initial state of the bodies"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(33)=(PropertyName="bDoEval",PropertyFriendlyName="Do Eval",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bDoEval", "If true we will perform bone transform evaluation, otherwise skip - allows visualization of the initial anim state compared to the physics sim"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(34)=(PropertyName="bOverrideLinearDamping",PropertyFriendlyName="Override Linear Damping",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bOverrideLinearDamping", "If true, the override value will be used for linear damping"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(35)=(PropertyName="bOverrideAngularBias",PropertyFriendlyName="Override Angular Bias",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bOverrideAngularBias", "If true, the override value will be used for the angular bias for bodies in this node.\nAngular bias is essentially a twist reduction for chain forces and defaults to a value to keep chains stability\nin check. When using single-body systems sometimes angular forces will look like they are \"catching-up\" with\nthe mesh, if that\'s the case override this and push it towards 1.0f until it settles correctly"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(36)=(PropertyName="bOverrideAngularDamping",PropertyFriendlyName="Override Angular Damping",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bOverrideAngularDamping", "If true, the override value will be used for angular damping"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
         ShowPinForProperties(37)=(PropertyName="bEnableWind",PropertyFriendlyName="Enable Wind",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bEnableWind", "Whether or not wind is enabled for the bodies in this simulation"),CategoryName="Wind")
         ShowPinForProperties(38)=(PropertyName="bUseGravityOverride",PropertyFriendlyName="Use Gravity Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bUseGravityOverride", "Use gravity override value vs gravity scale"),CategoryName="PhysicsParameters")
         ShowPinForProperties(39)=(PropertyName="bGravityOverrideInSimSpace",PropertyFriendlyName="Gravity Override In Sim Space",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bGravityOverrideInSimSpace", "If true the gravity override value is defined in simulation space, by default it is in world space"),CategoryName="PhysicsParameters",bHasOverridePin=True)
         ShowPinForProperties(40)=(PropertyName="bLinearSpring",PropertyFriendlyName="Linear Spring",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bLinearSpring", "If true the body will attempt to spring back to its initial position"),CategoryName="PhysicsParameters")
         ShowPinForProperties(41)=(PropertyName="bAngularSpring",PropertyFriendlyName="Angular Spring",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bAngularSpring", "If true the body will attempt to align itself with the specified angular target"),CategoryName="PhysicsParameters")
         ShowPinForProperties(42)=(PropertyName="bChain",PropertyFriendlyName="Chain",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bChain", "Set to true to use the solver to simulate a connected chain"),CategoryName="Setup")
         ShowPinForProperties(43)=(PropertyName="RetargetingSettings",PropertyFriendlyName="Retargeting Settings",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:RetargetingSettings", "The settings for rotation retargeting"),CategoryName="Retargeting")
         NodePosX=3808
