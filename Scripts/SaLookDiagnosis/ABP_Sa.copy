         ShowPinForProperties(10)=(PropertyName="OverrideWorldGravity",PropertyFriendlyName="Override World Gravity",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:OverrideWorldGravity", "Override gravity"),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(11)=(PropertyName="ExternalForce",PropertyFriendlyName="External Force",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:ExternalForce", "Applies a uniform external force in world space. This allows for easily faking inertia of movement while still simulating in component space for example"),CategoryName="Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(12)=(PropertyName="ComponentLinearAccScale",PropertyFriendlyName="Component Linear Acc Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:ComponentLinearAccScale", "When using non-world-space sim, this controls how much of the components world-space acceleration is passed on to the local-space simulation."),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(13)=(PropertyName="ComponentLinearVelScale",PropertyFriendlyName="Component Linear Vel Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:ComponentLinearVelScale", "When using non-world-space sim, this applies a \'drag\' to the bodies in the local space simulation, based on the components world-space velocity."),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(14)=(PropertyName="ComponentAppliedLinearAccClamp",PropertyFriendlyName="Component Applied Linear Acc Clamp",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:ComponentAppliedLinearAccClamp", "When using non-world-space sim, this is an overall clamp on acceleration derived from ComponentLinearAccScale and ComponentLinearVelScale, to ensure it is not too large."),CategoryName="Settings")
         ShowPinForProperties(15)=(PropertyName="SimSpaceSettings",PropertyFriendlyName="Sim Space Settings",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:SimSpaceSettings", "Settings for the system which passes motion of the simulation\'s space\ninto the simulation. This allows the simulation to pass a\nfraction of the world space motion onto the bodies which allows Bone-Space\nand Component-Space simulations to react to world-space movement in a\ncontrollable way.\nThis system is a superset of the functionality provided by ComponentLinearAccScale,\nComponentLinearVelScale, and ComponentAppliedLinearAccClamp. In general\nyou should not have both systems enabled."),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(16)=(PropertyName="CachedBoundsScale",PropertyFriendlyName="Cached Bounds Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:CachedBoundsScale", "Scale of cached bounds (vs. actual bounds).\nIncreasing this may improve performance, but overlaps may not work as well.\n(A value of 1.0 effectively disables cached bounds)."),CategoryName="Settings")
         ShowPinForProperties(17)=(PropertyName="BaseBoneRef",PropertyFriendlyName="Base Bone Ref",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:BaseBoneRef", "Matters if SimulationSpace is BaseBone"),CategoryName="Settings")
         ShowPinForProperties(18)=(PropertyName="OverlapChannel",PropertyFriendlyName="Overlap Channel",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:OverlapChannel", "The channel we use to find static geometry to collide with"),CategoryName="Settings")
         ShowPinForProperties(19)=(PropertyName="SimulationSpace",PropertyFriendlyName="Simulation Space",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:SimulationSpace", "What space to simulate the bodies in. This affects how velocities are generated"),CategoryName="Settings")
         ShowPinForProperties(20)=(PropertyName="bForceDisableCollisionBetweenConstraintBodies",PropertyFriendlyName="Force Disable Collision Between Constraint Bodies",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:bForceDisableCollisionBetweenConstraintBodies", "Whether to allow collisions between two bodies joined by a constraint"),CategoryName="Settings")
         ShowPinForProperties(21)=(PropertyName="bUseExternalClothCollision",PropertyFriendlyName="Use External Cloth Collision",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:bUseExternalClothCollision", "If true, kinematic objects will be added to the simulation at runtime to represent any cloth colliders defined for the parent object."),CategoryName="Settings")
         ShowPinForProperties(22)=(PropertyName="bEnableWorldGeometry",PropertyFriendlyName="Enable World Geometry",CategoryName="Settings")
         ShowPinForProperties(23)=(PropertyName="bOverrideWorldGravity",PropertyFriendlyName="Override World Gravity",CategoryName="Settings")
         ShowPinForProperties(24)=(PropertyName="bTransferBoneVelocities",PropertyFriendlyName="Transfer Bone Velocities",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:bTransferBoneVelocities", "When simulation starts, transfer previous bone velocities (from animation)\nto make transition into simulation seamless."),CategoryName="Settings",bCanToggleVisibility=True)
         ShowPinForProperties(25)=(PropertyName="bFreezeIncomingPoseOnStart",PropertyFriendlyName="Freeze Incoming Pose on Start",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:bFreezeIncomingPoseOnStart", "When simulation starts, freeze incoming pose.\nThis is useful for ragdolls, when we want the simulation to take over.\nIt prevents non simulated bones from animating."),CategoryName="Settings")
         ShowPinForProperties(26)=(PropertyName="bClampLinearTranslationLimitToRefPose",PropertyFriendlyName="Clamp Linear Translation Limit to Ref Pose",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:bClampLinearTranslationLimitToRefPose", "Correct for linear tearing on bodies with all axes Locked.\nThis only works if all axes linear translation are locked"),CategoryName="Settings")
         ShowPinForProperties(27)=(PropertyName="WorldSpaceMinimumScale",PropertyFriendlyName="World Space Minimum Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:WorldSpaceMinimumScale", "For world-space simulations, if the magnitude of the component\'s 3D scale is less than WorldSpaceMinimumScale, do not update the node."),CategoryName="Settings")
         ShowPinForProperties(28)=(PropertyName="EvaluationResetTime",PropertyFriendlyName="Evaluation Reset Time",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:EvaluationResetTime", "If the node is not evaluated for this amount of time (seconds), either because a lower LOD was in use for a while or the component was\nnot visible, reset the simulation to the default pose on the next evaluation. Set to 0 to disable time-based reset."),CategoryName="Settings")
         ShowPinForProperties(29)=(PropertyName="SimulationTiming",PropertyFriendlyName="Simulation Timing",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_RigidBody:SimulationTiming", "Whether the physics simulation runs synchronously with the node\'s evaluation or is run in the background until the next frame."),CategoryName="Settings",bIsMarkedForAdvancedDisplay=True)
