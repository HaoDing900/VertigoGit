# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Content/ThirdPerson/Maps/CQB1.umap
Content/ThirdPerson/Maps/Level0SubmarineInterior.umap
Plugins/Narrative/Content/NarrativeUI/Widgets/BP_Narrative3Overlay.uasset

# Marketplace asset raw source files (not needed by UE, too big for GitHub)
Content/MovementAnimsetPro/SourceFiles/

# --- Compiled editor binaries, shared so non-programmers don't have to build ---
# Everything under Binaries stays ignored by the rules above; these re-include just the
# editor module DLLs and their .modules manifests. No .pdb (60-300MB each), no .exe,
# no packaged builds. Requires everyone to be on the SAME engine build - the BuildId in
# UnrealEditor.modules has to match or the editor rebuilds anyway.
!Binaries/Win64/
Binaries/Win64/*
!Binaries/Win64/UnrealEditor-*.dll
!Binaries/Win64/UnrealEditor.modules

!Plugins/*/Binaries/Win64/
Plugins/*/Binaries/Win64/*
!Plugins/*/Binaries/Win64/UnrealEditor-*.dll
!Plugins/*/Binaries/Win64/UnrealEditor.modules

# The git hooks kept in version control (see Build/GitHooks/install.sh)
!Build/GitHooks/**
